<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RGIS Accuracy Flashcards</title><style>:root{font-family:Arial,Helvetica,sans-serif;color:#1d4153}*{box-sizing:border-box}body{margin:0;padding:8px;background:white}main{max-width:850px;margin:auto}h2{font-size:clamp(22px,3vw,29px);margin:0 0 12px}p{line-height:1.5;color:#526774;margin:0 0 16px}.lead{background:#f3f5f6;padding:17px 20px;border-radius:12px;margin:18px 0}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{border:0;border-radius:13px;min-height:195px;background:#f2f5f6;color:#1d4153;padding:18px 12px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;transition:background .2s,transform .15s}.card:hover{transform:translateY(-2px)}.card:focus-visible{outline:3px solid #dc263f;outline-offset:3px}.card[aria-pressed=true]{background:#1d4153;color:#fff}.small{font-size:12px;letter-spacing:.06em;font-weight:700}.big{font-size:clamp(25px,4vw,38px);font-weight:800;font-variant-numeric:tabular-nums}.detail{font-size:14px}.hint{font-size:12px;opacity:.8}.explain{margin-top:20px;border-left:4px solid #dc263f;background:#f3f5f6;border-radius:0 10px 10px 0;padding:17px 20px}.explain h3{font-size:17px;margin:0 0 9px}.explain p{margin:0 0 9px}.explain p:last-child{margin:0}.formula{font-size:13px;color:#667783;margin-top:14px}@media(max-width:540px){body{padding:6px}.cards{gap:8px}.card{min-height:175px;padding:12px 7px}.detail{font-size:12px}.small{font-size:10px}.big{font-size:clamp(20px,6vw,28px)}.hint{font-size:11px}}</style></head><body><main><div class="cards"><button class="card" type="button" aria-pressed="false" data-coverage="10%" data-pieces="500" data-accuracy="99.00%"><span class="small">CONTROL COVERAGE</span><span class="big">10%</span><span class="detail">500 pieces checked</span><span class="hint">Click to reveal ↻</span></button><button class="card" type="button" aria-pressed="false" data-coverage="25%" data-pieces="1250" data-accuracy="99.60%"><span class="small">CONTROL COVERAGE</span><span class="big">25%</span><span class="detail">1,250 pieces checked</span><span class="hint">Click to reveal ↻</span></button><button class="card" type="button" aria-pressed="false" data-coverage="50%" data-pieces="2500" data-accuracy="99.80%"><span class="small">CONTROL COVERAGE</span><span class="big">50%</span><span class="detail">2,500 pieces checked</span><span class="hint">Click to reveal ↻</span></button></div></main><script>document.querySelectorAll('.card').forEach(card=>card.addEventListener('click',()=>{const flipped=card.getAttribute('aria-pressed')==='true';card.setAttribute('aria-pressed',String(!flipped));card.innerHTML=flipped?`<span class="small">CONTROL COVERAGE</span><span class="big">${card.dataset.coverage}</span><span class="detail">${Number(card.dataset.pieces).toLocaleString('en-US')} pieces checked</span><span class="hint">Click to reveal ↻</span>`:`<span class="small">CALCULATED ACCURACY</span><span class="big">${card.dataset.accuracy}</span><span class="detail">5 errors identified</span><span class="hint">Click to flip back ↻</span>`}));</script></body></html>
